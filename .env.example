# Copy to `.env` (gitignored) and fill in YOUR local paths.
# This project NEVER downloads or sources plugins — it only reads the paths you set here.

# Directory that contains your installed VST3 plugins.
#   Windows : C:\Program Files\Common Files\VST3
#   macOS   : /Library/Audio/Plug-Ins/VST3
PLUGIN_DIR=C:\Program Files\Common Files\VST3

# Optional: a single specific plugin to use for the Phase 0 host check.
# If unset, phase0_host_check.py picks the first .vst3 it finds under PLUGIN_DIR.
# PLUGIN_PATH=C:\Program Files\Common Files\VST3\Archetype Plini.vst3

# Optional: a short clean DI guitar clip to render through the plugin in Phase 0.
# If unset, Phase 0 generates a synthetic test signal instead.
# DI_PATH=data/di/clean_di.wav

# Where Phase 0 / later phases write rendered audio (created if missing).
RENDER_DIR=data/renders

# Audio sample rate used for rendering/analysis.
SAMPLE_RATE=48000
